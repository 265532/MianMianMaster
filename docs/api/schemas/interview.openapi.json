        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseModel_InterviewSession_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [{ "OAuth2PasswordBearer": [] }]
      }
    },
    "/interview/sessions/{session_id}/report": {
      "get": {
        "tags": ["interview"],
        "summary": "获取面试报告",
        "description": "前端: 面试结束后的评估报告",
        "operationId": "get_report_interview_sessions_session_id_report_get",
        "parameters": [
          {
