  },
  "components": {
    "schemas": {
      "InterviewSessionCreate": {
        "properties": {
          "job_title": { "type": "string", "title": "Job Title" },
          "company": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Company" },
          "type": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Type" },
          "max_rounds": { "anyOf": [{ "type": "integer" }, { "type": "null" }], "title": "Max Rounds" }
        },
        "type": "object",
        "required": ["job_title"],
        "title": "InterviewSessionCreate"
      },
      "InterviewSession": {
        "properties": {
          "id": { "type": "string", "title": "Id" },
          "job_title": { "type": "string", "title": "Job Title" },
          "company": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Company" },
          "status": {
            "type": "string",
            "enum": ["scheduled", "in_progress", "completed", "cancelled"],
            "title": "Status"
          },
          "type": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Type" },
          "max_rounds": { "anyOf": [{ "type": "integer" }, { "type": "null" }], "title": "Max Rounds" },
          "current_round": { "anyOf": [{ "type": "integer" }, { "type": "null" }], "title": "Current Round" },
          "created_at": { "type": "string", "format": "date-time", "title": "Created At" },
          "started_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }], "title": "Started At" },
          "ended_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }], "title": "Ended At" },
          "total_score": { "anyOf": [{ "type": "number" }, { "type": "null" }], "title": "Total Score" },
          "feedback": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Feedback" },
          "details": {
            "anyOf": [
              {
                "properties": {
                  "technical": { "type": "number", "title": "Technical" },
                  "communication": { "type": "number", "title": "Communication" },
                  "logic": { "type": "number", "title": "Logic" },
                  "problem_solving": { "type": "number", "title": "Problem Solving" }
                },
                "type": "object"
              },
              { "type": "null" }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": ["id", "job_title", "status", "created_at"],
        "title": "InterviewSession"
      },
      "ChatRequest": {
        "properties": {
          "message": { "type": "string", "title": "Message", "description": "用户发送的面试回答" }
        },
        "type": "object",
        "required": ["message"],
        "title": "ChatRequest"
      },
      "InterviewReport": {
        "properties": {
          "session_id": { "type": "string", "title": "Session Id" },
          "status": {
            "type": "string",
            "enum": ["pending", "generating", "completed", "failed"],
            "title": "Status"
          },
          "overall_score": { "anyOf": [{ "type": "number" }, { "type": "null" }], "title": "Overall Score" },
          "dimensions": {
            "anyOf": [
              {
                "properties": {
                  "technical": { "type": "number", "title": "Technical" },
                  "communication": { "type": "number", "title": "Communication" },
                  "logic": { "type": "number", "title": "Logic" },
                  "problem_solving": { "type": "number", "title": "Problem Solving" }
                },
                "type": "object"
              },
              { "type": "null" }
            ],
            "title": "Dimensions"
          },
          "strengths": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Strengths",
            "default": []
          },
          "weaknesses": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Weaknesses",
            "default": []
          },
          "suggestions": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Suggestions",
            "default": []
          },
          "generated_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }], "title": "Generated At" }
        },
        "type": "object",
        "required": ["session_id", "status"],
        "title": "InterviewReport"
      },
      "InterviewQuestion": {
        "properties": {
          "id": { "type": "string", "title": "Id" },
          "content": { "type": "string", "title": "Content" },
          "type": {
            "type": "string",
            "enum": ["technical", "behavioral", "case"],
            "title": "Type"
          },
          "difficulty": {
            "type": "string",
            "enum": ["easy", "medium", "hard"],
            "title": "Difficulty"
          },
          "category": { "type": "string", "title": "Category" },
          "answered": { "type": "boolean", "title": "Answered" },
          "answer": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Answer" },
          "score": { "anyOf": [{ "type": "number" }, { "type": "null" }], "title": "Score" },
          "starAnswer": {
            "anyOf": [
              {
                "properties": {
                  "situation": { "type": "string", "title": "Situation" },
                  "task": { "type": "string", "title": "Task" },
                  "action": { "type": "string", "title": "Action" },
                  "result": { "type": "string", "title": "Result" }
                },
                "type": "object"
              },
              { "type": "null" }
            ],
            "title": "Star Answer"
          },
          "alternativeAnswers": {
            "items": {
              "properties": {
                "situation": { "type": "string", "title": "Situation" },
                "task": { "type": "string", "title": "Task" },
                "action": { "type": "string", "title": "Action" },
                "result": { "type": "string", "title": "Result" }
              },
              "type": "object"
            },
            "type": "array",
            "title": "Alternative Answers",
            "default": []
          },
          "commonMistakes": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Common Mistakes",
            "default": []
          }
        },
        "type": "object",
        "required": ["id", "content", "type", "difficulty", "category", "answered"],
        "title": "InterviewQuestion"
      },
      "GameLevel": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "name": { "type": "string", "title": "Name" },
          "title": { "type": "string", "title": "Title" },
          "status": { "type": "string", "title": "Status" },
          "progress": { "type": "number", "title": "Progress" },
          "description": { "type": "string", "title": "Description" },
          "interviews": { "type": "integer", "title": "Interviews" },
          "completed": { "type": "integer", "title": "Completed" },
          "timeSpent": { "type": "string", "title": "Time Spent" },
          "successRate": { "type": "string", "title": "Success Rate" },
          "skills": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Skills",
            "default": []
          },
          "unlockRequirements": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Unlock Requirements" },
          "icon": { "type": "string", "title": "Icon" },
          "background": { "type": "string", "title": "Background" },
          "difficulty": { "type": "string", "title": "Difficulty" },
          "reward": { "type": "string", "title": "Reward" },
          "questionCount": { "type": "integer", "title": "Question Count" },
          "timeLimit": { "type": "integer", "title": "Time Limit" }
        },
        "type": "object",
        "required": ["id", "name", "title", "status", "progress", "description", "interviews", "completed", "timeSpent", "successRate", "icon", "background", "difficulty", "reward", "questionCount", "timeLimit"],
        "title": "GameLevel"
      },
      "GameStats": {
        "properties": {
          "completedLevels": { "type": "integer", "title": "Completed Levels" },
          "totalQuestions": { "type": "integer", "title": "Total Questions" },
          "correctRate": { "type": "string", "title": "Correct Rate" },
          "certifications": { "type": "integer", "title": "Certifications" },
          "streak": { "type": "string", "title": "Streak" },
          "totalScore": { "type": "string", "title": "Total Score" }
        },
        "type": "object",
        "required": ["completedLevels", "totalQuestions", "correctRate", "certifications", "streak", "totalScore"],
        "title": "GameStats"
      },
      "GameAchievement": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "name": { "type": "string", "title": "Name" },
          "description": { "type": "string", "title": "Description" },
          "unlocked": { "type": "boolean", "title": "Unlocked" },
          "unlockedAt": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }], "title": "Unlocked At" },
          "progress": { "anyOf": [{ "type": "number" }, { "type": "null" }], "title": "Progress" },
          "icon": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Icon" }
        },
        "type": "object",
        "required": ["id", "name", "description", "unlocked"],
        "title": "GameAchievement"
      },
      "LeaderboardEntry": {
        "properties": {
          "rank": { "type": "integer", "title": "Rank" },
          "name": { "type": "string", "title": "Name" },
          "score": { "type": "number", "title": "Score" },
          "avatar": { "type": "string", "title": "Avatar" },
          "isCurrentUser": { "type": "boolean", "title": "Is Current User", "default": false }
        },
        "type": "object",
        "required": ["rank", "name", "score", "avatar"],
        "title": "LeaderboardEntry"
      },

      "ResponseModel_InterviewSession_": {
        "properties": {
          "code": { "type": "integer", "title": "Code", "default": 200 },
          "message": { "type": "string", "title": "Message", "default": "success" },
          "data": { "anyOf": [{ "$ref": "#/components/schemas/InterviewSession" }, { "type": "null" }] }
        },
        "type": "object",
        "title": "ResponseModel[InterviewSession]"
      },
      "ResponseModel_List_InterviewSession_": {
        "properties": {
          "code": { "type": "integer", "title": "Code", "default": 200 },
          "message": { "type": "string", "title": "Message", "default": "success" },
