  "components": {
    "schemas": {
      "CourseCreate": {
        "properties": {
          "title": { "type": "string", "title": "Title" },
          "description": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Description" },
          "category": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Category" },
          "difficulty": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Difficulty" }
        },
        "type": "object",
        "required": ["title"],
        "title": "CourseCreate"
      },
      "Course": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "title": { "type": "string", "title": "Title" },
          "description": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Description" },
          "category": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Category" },
          "difficulty": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Difficulty" },
          "created_at": { "type": "string", "format": "date-time", "title": "Created At" },
          "updated_at": { "type": "string", "format": "date-time", "title": "Updated At" }
        },
        "type": "object",
        "required": ["id", "title", "created_at", "updated_at"],
        "title": "Course"
      },
      "MaterialCreate": {
        "properties": {
          "course_id": { "type": "integer", "title": "Course Id" },
          "title": { "type": "string", "title": "Title" },
          "type": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Type" },
          "url": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Url" }
        },
        "type": "object",
        "required": ["course_id", "title"],
        "title": "MaterialCreate"
      },
      "Material": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "course_id": { "type": "integer", "title": "Course Id" },
          "title": { "type": "string", "title": "Title" },
          "type": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Type" },
          "url": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Url" },
          "created_at": { "type": "string", "format": "date-time", "title": "Created At" }
        },
        "type": "object",
        "required": ["id", "course_id", "title", "created_at"],
        "title": "Material"
      },
      "ProgressUpdateRequest": {
        "properties": {
          "course_id": { "type": "integer", "title": "Course Id" },
          "progress": { "type": "number", "title": "Progress", "description": "进度百分比 0-100" }
        },
        "type": "object",
        "required": ["course_id", "progress"],
        "title": "ProgressUpdateRequest"
      },
      "LearningProgress": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "user_id": { "type": "integer", "title": "User Id" },
          "course_id": { "type": "integer", "title": "Course Id" },
          "progress": { "type": "number", "title": "Progress" },
          "updated_at": { "type": "string", "format": "date-time", "title": "Updated At" }
        },
        "type": "object",
        "required": ["id", "user_id", "course_id", "progress", "updated_at"],
        "title": "LearningProgress"
      },
      "AddToCollectionRequest": {
        "properties": {
          "title": { "type": "string", "title": "Title" },
          "description": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Description" },
          "question_ids": {
            "items": { "type": "integer" },
            "type": "array",
            "title": "Question Ids",
            "default": []
          },
          "category": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Category" },
          "difficulty": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Difficulty" }
        },
        "type": "object",
        "required": ["title"],
        "title": "AddToCollectionRequest"
      },
      "Collection": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "title": { "type": "string", "title": "Title" },
          "description": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Description" },
          "question_count": { "anyOf": [{ "type": "integer" }, { "type": "null" }], "title": "Question Count" },
          "category": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Category" },
          "difficulty": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Difficulty" },
          "saved_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }], "title": "Saved At" },
          "last_practiced": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }], "title": "Last Practiced" }
        },
        "type": "object",
        "required": ["id", "title"],
        "title": "Collection"
      },
      "RecordWrongQuestionRequest": {
        "properties": {
          "question": { "type": "string", "title": "Question" },
          "user_answer": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "User Answer" },
          "correct_answer": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Correct Answer" },
          "explanation": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Explanation" },
          "category": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Category" },
          "difficulty": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Difficulty" }
        },
        "type": "object",
        "required": ["question"],
        "title": "RecordWrongQuestionRequest"
      },
      "WrongQuestion": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "question": { "type": "string", "title": "Question" },
          "user_answer": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "User Answer" },
          "correct_answer": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Correct Answer" },
          "explanation": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Explanation" },
          "category": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Category" },
          "difficulty": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Difficulty" },
          "mistake_count": { "anyOf": [{ "type": "integer" }, { "type": "null" }], "title": "Mistake Count" },
          "last_mistake_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }], "title": "Last Mistake At" },
          "status": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Status" }
        },
        "type": "object",
        "required": ["id", "question"],
        "title": "WrongQuestion"
      },
      "CreateBadgeRequest": {
        "properties": {
          "name": { "type": "string", "title": "Name" },
          "description": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Description" },
          "icon_url": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Icon Url" }
        },
        "type": "object",
        "required": ["name"],
        "title": "CreateBadgeRequest"
      },
      "Badge": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "name": { "type": "string", "title": "Name" },
          "description": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Description" },
          "icon_url": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Icon Url" },
          "created_at": { "type": "string", "format": "date-time", "title": "Created At" }
        },
        "type": "object",
        "required": ["id", "name", "created_at"],
        "title": "Badge"
      },
      "UserBadge": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "badge_id": { "type": "integer", "title": "Badge Id" },
          "badge": {
            "anyOf": [{ "$ref": "#/components/schemas/Badge" }, { "type": "null" }]
          },
          "awarded_at": { "type": "string", "format": "date-time", "title": "Awarded At" }
        },
        "type": "object",
        "required": ["id", "badge_id", "awarded_at"],
        "title": "UserBadge"
      },

      "ResponseModel_Course_": {
        "properties": {
          "code": { "type": "integer", "title": "Code", "default": 200 },
          "message": { "type": "string", "title": "Message", "default": "success" },
          "data": { "anyOf": [{ "$ref": "#/components/schemas/Course" }, { "type": "null" }] }
        },
        "type": "object",
        "title": "ResponseModel[Course]"
      },
      "ResponseModel_List_Course_": {
        "properties": {
          "code": { "type": "integer", "title": "Code", "default": 200 },
          "message": { "type": "string", "title": "Message", "default": "success" },
          "data": {
