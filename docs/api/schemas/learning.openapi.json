        "description": "前端: Learning.vue 课程列表; type=practice 时获取题库",
        "operationId": "get_courses_learning_courses_get",
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Skip"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "课程类型筛选，如 practice 表示题库",
            "schema": {
              "type": "string",
              "title": "Type"
            }
          }
